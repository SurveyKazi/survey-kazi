<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SurveyKaxi - Earn by Sharing Your Opinion</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f7fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 18px;
      font-size: 14px;
    }

    .hero {
      padding: 70px 6%;
      text-align: center;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      color: white;
    }

    .hero h1 {
      font-size: 42px;
      margin-bottom: 18px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      line-height: 1.6;
      font-size: 18px;
    }

    .buttons {
      margin-top: 30px;
    }

    button {
      border: none;
      padding: 14px 25px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 16px;
      font-weight: bold;
    }

    .primary {
      background: white;
      color: #2563eb;
    }

    .secondary {
      background: transparent;
      color: white;
      border: 2px solid white;
      margin-left: 10px;
    }

    .section {
      padding: 55px 6%;
      text-align: center;
    }

    .section h2 {
      font-size: 30px;
      margin-bottom: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 30px 20px;
      border-radius: 14px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
    }

    .icon {
      font-size: 40px;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #667085;
      line-height: 1.5;
    }

    .survey-box {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 15px;
      text-align: left;
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
    }

    .survey {
      padding: 18px 0;
      border-bottom: 1px solid #eee;
    }

    .survey:last-child {
      border-bottom: none;
    }

    .survey h3 {
      margin-bottom: 8px;
    }

    .reward {
      color: #16a34a;
      font-weight: bold;
    }

    footer {
      background: #111827;
      color: #cbd5e1;
      text-align: center;
      padding: 25px;
      margin-top: 30px;
    }

    @media(max-width:600px) {
      .hero h1 {
        font-size: 32px;
      }

      nav {
        display: none;
      }

      .secondary {
        margin-left: 0;
        margin-top: 10px;
      }
    }
  </style>
</head>

